// Q2_0 x Q8_0 row GEMV (stage C). Mirrors src/kernels/q2_0.cpp's
// q2_0_dot_q8_0 line for line: per Q2_0 block (18 B: fp16 d + 16 B codes),
// two Q8_0 activation sub-blocks (34 B each: fp16 d + 32 int8), integer MACs
// into int, one fp32 multiply per sub-block scale, then the block scale.
//
// The iGPU has no VK_KHR_shader_integer_dot_product (measured: 192 extensions
// scanned, integer_dot_product absent), so the MACs are hand-written, as the
// spec requires.
//
// Build: glslangValidator -V q2_0_gemv.comp -o q2_0_gemv.spv (see README.md).
#version 450

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer W { uint w[]; };  // n_rows x n_blocks x 18 B
layout(std430, binding = 1) readonly buffer Y { uint y[]; };  // 2*n_blocks x 34 B activation
layout(std430, binding = 2) writeonly buffer O { float o[]; };

layout(push_constant) uniform Pc {
    uint n_rows;
    uint n_blocks;
} pc;

// Byte access over the uint-backed buffers (little-endian, same as the host).
uint wbyte(uint off) { return (w[off >> 2] >> ((off & 3u) * 8u)) & 0xFFu; }
uint ybyte(uint off) { return (y[off >> 2] >> ((off & 3u) * 8u)) & 0xFFu; }

// fp16 bits -> fp32, matching kernels/fp16.hpp f16_bits_to_f32 (normal and
// subnormal paths; the scale words are always finite in quantized data).
float f16(uint h) {
    uint s = (h >> 15) & 1u;
    uint e = (h >> 10) & 0x1Fu;
    uint m = h & 0x3FFu;
    float v = 0.0;
    if (e == 0u) {
        v = ldexp(float(m), -24);
    } else if (e != 31u) {
        v = ldexp(1.0 + float(m) / 1024.0, int(e) - 15);
    }
    return s != 0u ? -v : v;
}

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.n_rows) return;
    uint row_base = row * pc.n_blocks * 18u;
    // `precise` forbids contraction/reassociation: without it the Intel compiler
    // fuses `d1 * float(sb)` into the accumulator and the results differ from
    // the host in the last bits (measured: L1 4e-08 but bit-same 0.56). The
    // CUDA kernels get the same guarantee from __fmul_rn/__fadd_rn.
    precise float sumf = 0.0;
    for (uint i = 0u; i < pc.n_blocks; ++i) {
        uint blk = row_base + i * 18u;
        precise float d0 = f16(wbyte(blk) | (wbyte(blk + 1u) << 8));
        precise float sumi = 0.0;
        for (uint k = 0u; k < 2u; ++k) {
            uint yb = (i * 2u + k) * 34u;
            precise float d1 = f16(ybyte(yb) | (ybyte(yb + 1u) << 8));
            int sb = 0;
            for (uint b = 0u; b < 8u; ++b) {
                uint byte = wbyte(blk + 2u + k * 8u + b);
                for (uint j = 0u; j < 4u; ++j) {
                    int code = int((byte >> (2u * j)) & 3u) - 1;
                    int q = int(ybyte(yb + 2u + b * 4u + j));
                    if (q > 127) q -= 256;  // int8
                    sb += code * q;
                }
            }
            sumi += d1 * float(sb);
        }
        sumf += d0 * sumi;
    }
    o[row] = sumf;
}