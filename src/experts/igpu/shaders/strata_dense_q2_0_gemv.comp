// Strata dense projection Q2_0 weights x Q8_1 activation GEMV.
//
// For large GDN dense projections (attn_qkv, attn_gate, ssm_out) on iGPU.
// P1 spike measured iGPU 3.9x faster than CPU for 10240x2560 matrices.
//
// Weight format: Q2_0 interleaved (18 bytes per block: 16 codes + 2 scale)
//   GGUF stores row-major: row 0 blocks, row 1 blocks, ...
//   Each block: 16 bytes codes (64 x 2-bit) + 2 bytes fp16 scale
// Activation format: Q8_1 planar (codes, then scales, then sums)
//   codes:  n_blocks_a * 32 bytes (int8 codes, 32 per block)
//   scales: n_blocks_a * 2 bytes (fp16 scale per block)
//   sums:   n_blocks_a * 2 bytes (fp16 sum per block)
//
// Per block b:
//   d_w = weight_scale[b]  (fp16 -> fp32)
//   d_a = act_scale[b]     (fp16 -> fp32)
//   sum_a = act_sum[b]     (fp16 -> fp32)
//   dot = sum_{j=0}^{31} raw_code_j * q[j]   (raw codes 0-3, q is signed int8)
//   The -1 offset per code contributes -d_w * d_a * sum_a
//   result += d_w * d_a * dot - d_w * d_a * sum_a
//
// Build: glslangValidator -V strata_dense_q2_0_gemv.comp -o strata_dense_q2_0_gemv.spv
#version 450

layout(local_size_x = 64) in;

// Weight buffer: interleaved Q2_0 blocks (18 bytes each: 16 codes + 2 scale)
// Row r starts at r * n_blocks_w * 18
layout(std430, binding = 0) readonly buffer Weights { uint weights[]; };

// Q8_1 activation buffer (planar):
//   codes:  n_blocks_a * 32 bytes (int8 codes, 32 per block)
//   scales: n_blocks_a * 2 bytes (fp16 scale per block)
//   sums:   n_blocks_a * 2 bytes (fp16 sum per block)
layout(std430, binding = 1) readonly buffer ActCodes { uint act_codes[]; };
layout(std430, binding = 2) readonly buffer ActScales { uint act_scales[]; };
layout(std430, binding = 3) readonly buffer ActSums { uint act_sums[]; };

// Output: one fp32 per row.
layout(std430, binding = 4) writeonly buffer Out { float out_arr[]; };

layout(push_constant) uniform Pc {
    uint n_rows;       // number of weight rows (e.g., 10240 for attn_qkv)
    uint n_blocks_w;   // Q2_0 blocks per weight row (n_in / 64)
    uint n_blocks_a;   // Q8_1 blocks per activation (n_in / 32) = 2 * n_blocks_w
} pc;

// Byte access over uint-backed SSBOs (little-endian, same as the host).
uint w_byte(uint off)   { return (weights[off >> 2]   >> ((off & 3u) * 8u)) & 0xFFu; }
uint ac_byte(uint off)  { return (act_codes[off >> 2] >> ((off & 3u) * 8u)) & 0xFFu; }
uint as_byte(uint off)  { return (act_scales[off >> 2] >> ((off & 3u) * 8u)) & 0xFFu; }
uint su_byte(uint off)  { return (act_sums[off >> 2] >> ((off & 3u) * 8u)) & 0xFFu; }

// fp16 bits -> fp32
float f16(uint h) {
    uint s = (h >> 15) & 1u;
    uint e = (h >> 10) & 0x1Fu;
    uint m = h & 0x3FFu;
    float v = 0.0;
    if (e == 0u) {
        v = ldexp(float(m), -24);
    } else if (e != 31u) {
        v = ldexp(1.0 + float(m) / 1024.0, int(e) - 15);
    }
    return s != 0u ? -v : v;
}

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.n_rows) return;

    // Row starts at row * n_blocks_w * 18 bytes (interleaved Q2_0)
    uint w_row_off = row * pc.n_blocks_w * 18u;

    precise float acc = 0.0;

    // Each Q2_0 weight block spans 64 elements = 2 Q8_1 blocks (32 elements each)
    for (uint b = 0u; b < pc.n_blocks_w; ++b) {
        // Block offset in weight buffer (18 bytes per block)
        uint w_blk_off = w_row_off + b * 18u;

        // Weight scale at offset 16-17 (fp16 -> fp32)
        precise float d_w = f16(w_byte(w_blk_off + 16u) | (w_byte(w_blk_off + 17u) << 8));

        // Process two halves (each maps to one Q8_1 block)
        for (uint h = 0u; h < 2u; ++h) {
            uint act_block = 2u * b + h;  // Q8_1 block index

            // Activation scale and sum for this block (fp16 -> fp32)
            uint as_off = act_block * 2u;
            precise float d_a = f16(as_byte(as_off) | (as_byte(as_off + 1u) << 8));
            precise float sum_a = f16(su_byte(as_off) | (su_byte(as_off + 1u) << 8));

            // Integer dot product: raw 2-bit codes (0-3) * signed int8 activation codes
            // 8 bytes of weight codes per half, 4 codes per byte = 32 codes total
            int sb = 0;
            for (uint bi = 0u; bi < 8u; ++bi) {
                uint code_byte = w_byte(w_blk_off + h * 8u + bi);
                for (uint j = 0u; j < 4u; ++j) {
                    int raw_code = int((code_byte >> (2u * j)) & 3u);
                    int q = int(ac_byte(act_block * 32u + bi * 4u + j));
                    if (q > 127) q -= 256;  // interpret uint8 as signed int8
                    sb += raw_code * q;
                }
            }

            // Scale the integer dot by both scales
            // The -1 offset per raw code contributes -d_w * d_a * sum_a
            precise float ds = d_w * d_a;
            acc += ds * float(sb) - ds * sum_a;
        }
    }

    out_arr[row] = acc;
}
