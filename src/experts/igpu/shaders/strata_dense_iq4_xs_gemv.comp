// Strata dense projection IQ4_XS weights x Q8_1 activation GEMV.
//
// For large GDN dense projections (attn_qkv) on iGPU.
//
// Weight format: IQ4_XS interleaved (136 bytes per super-block: 2 d + 2 scales_h + 4 scales_l + 128 qs)
//   GGUF stores row-major: row 0 super-blocks, row 1 super-blocks, ...
//   Each super-block: 256 elements = 8 sub-blocks of 32
//   d: fp16 super-block scale
//   scales_h: uint16, high 2 bits of each sub-block's 6-bit scale
//   scales_l: uint8[4], low 4 bits (2 sub-blocks per byte)
//   qs: uint8[128], 4-bit indices (2 per byte), non-linear lookup
//
// Activation format: Q8_1 planar (codes, then scales, then sums)
//   codes:  n_blocks_a * 32 bytes (int8 codes, 32 per block)
//   scales: n_blocks_a * 2 bytes (fp16 scale per block)
//   sums:   n_blocks_a * 2 bytes (fp16 sum per block)
//
// Per super-block sb (256 elements = 8 Q8_1 blocks):
//   d = super-block scale (fp16 -> fp32)
//   For each sub-block ib (32 elements = 1 Q8_1 block):
//     ls = 6-bit scale: low 4 from scales_l, high 2 from scales_h
//     sub_scale = d * (ls - 32)
//     For each element j in [0, 31]:
//       4-bit index from qs (low nibble for j<16, high nibble for j>=16)
//       w = kvalues_iq4nl[index]  (non-linear table)
//       dot += w * q[j]  (q is signed int8 activation code)
//     result += sub_scale * dot
//
// Build: glslangValidator -V strata_dense_iq4_xs_gemv.comp -o strata_dense_iq4_xs_gemv.spv
#version 450

layout(local_size_x = 64) in;

// Weight buffer: interleaved IQ4_XS super-blocks (136 bytes each)
layout(std430, binding = 0) readonly buffer Weights { uint weights[]; };

// Q8_1 activation buffer (planar)
layout(std430, binding = 1) readonly buffer ActCodes { uint act_codes[]; };
layout(std430, binding = 2) readonly buffer ActScales { uint act_scales[]; };
layout(std430, binding = 3) readonly buffer ActSums { uint act_sums[]; };

// Output: one fp32 per row.
layout(std430, binding = 4) writeonly buffer Out { float out_arr[]; };

layout(push_constant) uniform Pc {
    uint n_rows;       // number of weight rows
    uint n_blocks_w;   // IQ4_XS super-blocks per weight row (n_in / 256)
    uint n_blocks_a;   // Q8_1 blocks per activation (n_in / 32) = 8 * n_blocks_w
} pc;

// Byte access over uint-backed SSBOs (little-endian)
uint w_byte(uint off)   { return (weights[off >> 2]   >> ((off & 3u) * 8u)) & 0xFFu; }
uint ac_byte(uint off)  { return (act_codes[off >> 2] >> ((off & 3u) * 8u)) & 0xFFu; }
uint as_byte(uint off)  { return (act_scales[off >> 2] >> ((off & 3u) * 8u)) & 0xFFu; }

// fp16 bits -> fp32
float f16(uint h) {
    uint s = (h >> 15) & 1u;
    uint e = (h >> 10) & 0x1Fu;
    uint m = h & 0x3FFu;
    float v = 0.0;
    if (e == 0u) {
        v = ldexp(float(m), -24);
    } else if (e != 31u) {
        v = ldexp(1.0 + float(m) / 1024.0, int(e) - 15);
    }
    return s != 0u ? -v : v;
}

// IQ4 non-linear lookup table (16 entries, signed int8)
// From ggml-common.h kvalues_iq4nl
int iq4nl(uint idx) {
    // idx in [0, 15]
    const int table[16] = int[16](
        -127, -104, -83, -65, -49, -35, -22, -10,
           1,   13,  25,  38,  53,  69,  89, 113
    );
    return table[idx & 0xFu];
}

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.n_rows) return;

    // Row starts at row * n_blocks_w * 136 bytes
    uint w_row_off = row * pc.n_blocks_w * 136u;

    precise float acc = 0.0;

    // Each IQ4_XS super-block spans 256 elements = 8 Q8_1 blocks
    for (uint sb = 0u; sb < pc.n_blocks_w; ++sb) {
        uint blk_off = w_row_off + sb * 136u;

        // Super-block scale d (fp16 at offset 0-1)
        precise float d = f16(w_byte(blk_off) | (w_byte(blk_off + 1u) << 8));

        // scales_h (uint16 at offset 2-3)
        uint scales_h = w_byte(blk_off + 2u) | (w_byte(blk_off + 3u) << 8);

        // Process 8 sub-blocks of 32 elements each
        for (uint ib = 0u; ib < 8u; ++ib) {
            // Decode 6-bit sub-block scale
            // scales_l[ib/2]: low nibble for even ib, high nibble for odd ib
            uint sl_byte = w_byte(blk_off + 4u + (ib >> 1u));
            uint sl = (ib == 0u || ib == 2u || ib == 4u || ib == 6u)
                      ? (sl_byte & 0xFu)
                      : ((sl_byte >> 4u) & 0xFu);
            uint sh = (scales_h >> (2u * ib)) & 3u;
            uint ls = sl | (sh << 4u);
            precise float sub_scale = d * (float(ls) - 32.0);

            // Q8_1 activation block for this sub-block
            uint act_block = 8u * sb + ib;

            // Activation scale (fp16 -> fp32)
            uint as_off = act_block * 2u;
            precise float d_a = f16(as_byte(as_off) | (as_byte(as_off + 1u) << 8));

            // Integer dot product: IQ4_XS codes * Q8_1 codes
            // qs starts at offset 8 in the super-block
            // Sub-block ib uses 16 bytes: qs[ib*16 .. ib*16+15]
            // Byte j: low nibble -> element j, high nibble -> element j+16
            int dot = 0;
            for (uint j = 0u; j < 16u; ++j) {
                uint qs_byte = w_byte(blk_off + 8u + ib * 16u + j);
                uint idx_lo = qs_byte & 0xFu;
                uint idx_hi = (qs_byte >> 4u) & 0xFu;

                int w_lo = iq4nl(idx_lo);
                int w_hi = iq4nl(idx_hi);

                int q_lo = int(ac_byte(act_block * 32u + j));
                int q_hi = int(ac_byte(act_block * 32u + 16u + j));
                if (q_lo > 127) q_lo -= 256;
                if (q_hi > 127) q_hi -= 256;

                dot += w_lo * q_lo + w_hi * q_hi;
            }

            acc += sub_scale * d_a * float(dot);
        }
    }

    out_arr[row] = acc;
}
